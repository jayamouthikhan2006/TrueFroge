# ForgeCode / TrueForge configuration. Copy to .env (scripts/setup-trueforge.sh
# does this for you) and fill in at least one model. Read by
# scripts/setup-trueforge.sh and by the VS Code extension's provisioner.

# TrueForge server (npx @truefoundry/trueforge@latest)
TRUEFORGE_BASE_URL=http://localhost:8790
# Only needed when TrueForge auth is enabled.
TRUEFORGE_API_KEY=

# ---- Primary model ----------------------------------------------------------
# type: custom (any OpenAI-compatible endpoint), openai, anthropic,
#       google-gemini, fireworks, together, zai, moonshot, alibaba
FORGE_PRIMARY_PROVIDER_TYPE=custom
FORGE_PRIMARY_PROVIDER_NAME=forge-primary
FORGE_PRIMARY_BASE_URL=https://api.openai.com/v1
FORGE_PRIMARY_API_KEY=
FORGE_PRIMARY_MODEL_ID=gpt-4.1
FORGE_PRIMARY_CONTEXT_LENGTH=128000
FORGE_PRIMARY_MAX_OUTPUT_TOKENS=16384
# Comma-separated subset of: none,minimal,low,medium,high,xhigh,max
FORGE_PRIMARY_REASONING_EFFORTS=

# ---- Fallback model (automatic failover target) ----------------------------
FORGE_FALLBACK_PROVIDER_TYPE=anthropic
FORGE_FALLBACK_PROVIDER_NAME=forge-fallback
FORGE_FALLBACK_BASE_URL=
FORGE_FALLBACK_API_KEY=
FORGE_FALLBACK_MODEL_ID=claude-sonnet-5-5
FORGE_FALLBACK_CONTEXT_LENGTH=200000
FORGE_FALLBACK_MAX_OUTPUT_TOKENS=16384
FORGE_FALLBACK_REASONING_EFFORTS=

# ---- Example: the demo configuration -------------------------------------------
# NVIDIA Nemotron models behind an OmniRoute gateway (any OpenAI-compatible
# gateway works the same way):
#   FORGE_PRIMARY_PROVIDER_TYPE=custom
#   FORGE_PRIMARY_PROVIDER_NAME=forge-primary
#   FORGE_PRIMARY_BASE_URL=http://<omniroute-host>:20128/v1
#   FORGE_PRIMARY_MODEL_ID=nvidia/nvidia/nemotron-3-ultra-550b-a55b
#   FORGE_FALLBACK_PROVIDER_TYPE=custom
#   FORGE_FALLBACK_PROVIDER_NAME=forge-fallback
#   FORGE_FALLBACK_BASE_URL=http://<omniroute-host>:20128/v1
#   FORGE_FALLBACK_MODEL_ID=nvidia/nvidia/nemotron-3.5-lightning-30b-a3b
# Gemini 3.x: route through the bundled thought-signature gateway, which
# scripts/setup-trueforge.sh starts automatically:
#   FORGE_PRIMARY_BASE_URL=http://127.0.0.1:8792/v1beta/openai
#   FORGE_PRIMARY_MODEL_ID=gemini-3-flash-preview

# ---- Task C (resilience) -----------------------------------------------------
# Break the primary on purpose, then re-run scripts/setup-trueforge.sh:
#   FORGE_PRIMARY_BASE_URL=http://localhost:9999/v1     (connection refused)
#   FORGE_PRIMARY_API_KEY=sk-invalid                     (401)

# ---- Workspace MCP server (embedded in the extension) -----------------------
FORGECODE_MCP_HOST=127.0.0.1
FORGECODE_MCP_PORT=8791
# Generated on first setup if empty; the extension reads it from this file.
FORGECODE_MCP_TOKEN=

# ---- Optional: native TrueForge skills ---------------------------------------
# TrueForge runs skills inside a sandbox (macOS/Linux local sandbox or a
# configured sandbox provider). When available, point this at a public git
# repository containing this project to register the SKILL.md packs natively.
FORGECODE_SKILLS_GIT_URL=
FORGECODE_SKILLS_GIT_REF=main
FORGECODE_SKILLS_GIT_PATH=trueforge-config
